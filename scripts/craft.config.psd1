# craft.config.psd1 - per-repo settings for start.ps1 and scripts\release.ps1.
# Generated by mcp-central-docs\scripts\sync-craft-scaffold.ps1, then owned by this repo:
# edit freely, sync never overwrites it. Standard: standards\rust-artcraft\CRAFT_START_AND_RELEASE.md
# Smoke arguments: {db} becomes a throwaway database path. Empty list = no such smoke.
@{
    Name        = 'synthcraft'
    Display     = 'SynthCraft'
    AppPackage  = 'synthcraft-app'
    AppBin      = 'synthcraft-app'
    AppSmoke    = @('--smoke')
    CliPackage  = 'synthcraft-mcp'
    CliBin      = 'synthcraft-mcp'
    CliSmoke    = @('--db', '{db}', 'status')
    McpArgs     = @('--mcp')
    McpSmoke    = @('--automation-read-root', '.', '--automation-write-root', '.', '--mcp')
    Installer   = $true
    Mcpb        = $true
    Floor       = $true
}
